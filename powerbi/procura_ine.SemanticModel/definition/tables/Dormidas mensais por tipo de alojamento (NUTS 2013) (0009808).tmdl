table 'Dormidas mensais por tipo de alojamento (NUTS 2013) (0009808)'
	lineageTag: dacc25b2-ca32-559c-aac0-548070b07e49

	measure 'Dormidas mensais (tipo)' = SUM('Dormidas mensais por tipo de alojamento (NUTS 2013) (0009808)'[dormidas])
		formatString: #,0
		lineageTag: d0057902-5608-50b1-94e0-481d88842526

	/// Dormidas mensais por tipo de alojamento (NUTS 2013) do ano anterior.
	measure 'Dormidas mensais (tipo, ano anterior)' = CALCULATE([Dormidas mensais (tipo)], DATEADD('Calendário'[Date], -1, YEAR))
		formatString: #,0
		lineageTag: 9382369c-1c24-5fb4-a79f-e4ac4cdbea61

	/// Variação homóloga de [Dormidas mensais (tipo)]. Em branco sem ano anterior publicado.
	measure 'Dormidas mensais (tipo) YoY %' =
			VAR Atual = [Dormidas mensais (tipo)]
			VAR Anterior = [Dormidas mensais (tipo, ano anterior)]
			RETURN DIVIDE(Atual - Anterior, Anterior)
		formatString: 0.0%
		lineageTag: 7ee44ee9-81e6-5295-bd9a-c26ef2916e75

