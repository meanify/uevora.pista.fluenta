	partition 'Dormidas por tipo de alojamento PT (9878)' = m
		mode: import
		source = ```
				let
				    Origem = PostgreSQL.Database("pistadb.pistadigital.uevora.pt:30392", "pista"),
				  Personalizado = Origem{[Schema = "public", Item = "ine_0009877_ds"]}[Data],
				    Regiao = Table.SelectRows(Personalizado, each true = true),
				    Combinacoes = Table.Buffer(Table.Distinct(Table.SelectColumns(Regiao, {"tipo_alojamento", "subtipo_alojamento", "classificacao"}))),
				    TiposComSubtipo = List.Buffer(List.Distinct(Table.SelectRows(Combinacoes, each [subtipo_alojamento] <> "Total")[tipo_alojamento])),
				    SubtiposComClasse = List.Buffer(List.Distinct(Table.SelectRows(Combinacoes, each [classificacao] <> "Total")[subtipo_alojamento])),
				    Folhas = Table.SelectRows(Regiao, each [tipo_alojamento] <> "Total"),
				    GeoKey = Table.AddColumn(Folhas, "GeoKey", each [nuts_i] & "|" & [nuts_ii] & "|" & [nuts_iii] & "|" & [distrito] & "|" & [municipio], type text),
				    NutsII = Table.AddColumn(GeoKey, "NutsIIKey", each [nuts_i] & "|" & [nuts_ii], type text),
				  ReplaceAlojamento = Table.ReplaceValue(
				    #"NutsII",
				    each [subtipo_alojamento],
				    each if Text.Lower([tipo_alojamento]) = "alojamento local" then "Alojamento Local" 
				         else if Text.Contains(Text.Lower([tipo_alojamento]), "rural") or Text.Contains(Text.Lower([tipo_alojamento]), "habitação") then "Turismo no Espaço Rural e de Habitação" 
				         else [subtipo_alojamento],
				    Replacer.ReplaceValue,
				    {"subtipo_alojamento"}
				)
				in
				    ReplaceAlojamento
				```

	annotation PBI_ResultType = Table

