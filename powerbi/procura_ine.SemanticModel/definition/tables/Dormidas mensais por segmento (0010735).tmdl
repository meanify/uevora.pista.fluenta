table 'Dormidas mensais por segmento (0010735)'
	lineageTag: a773dc4a-2f9a-5d80-bbab-0358bc7b86e2

	measure 'Dormidas mensais (segmento)' = SUM('Dormidas mensais por segmento (0010735)'[dormidas])
		formatString: #,0
		lineageTag: a268ad13-78e4-5e06-9d9f-43b8fe8de328

	/// Dormidas mensais por segmento do ano anterior.
	measure 'Dormidas mensais (segmento, ano anterior)' = CALCULATE([Dormidas mensais (segmento)], DATEADD('Calendário'[Date], -1, YEAR))
		formatString: #,0
		lineageTag: 4b53c3f9-568f-556e-8f38-55230928a679

	/// Variação homóloga de [Dormidas mensais (segmento)]. Em branco sem ano anterior publicado.
	measure 'Dormidas mensais (segmento) YoY %' =
			VAR Atual = [Dormidas mensais (segmento)]
			VAR Anterior = [Dormidas mensais (segmento, ano anterior)]
			RETURN DIVIDE(Atual - Anterior, Anterior)
		formatString: 0.0%
		lineageTag: 01381692-1c2a-5c98-886b-6235e808076c

	measure 'Taxa Sazonalidade' = ```
			
			-- 1. Captura os anos selecionados na tabela de filtros exterior
			VAR AnosSelecionados = VALUES(Ano[Ano])
			
			-- 2. Calcula o Total do Ano respeitando o filtro de Ano exterior e os filtros geográficos
			VAR TotalAno = 
			    CALCULATE(
			        SUM('Dormidas mensais por segmento (0010735)'[dormidas]),
			        ALL('Dormidas mensais por segmento (0010735)'[mes]),
			        'Dormidas mensais por segmento (0010735)'[ano] IN AnosSelecionados
			    )
			
			-- 3. Cria a tabela virtual para encontrar os 3 maiores meses considerando o ano filtrado
			VAR TabelaTop3 = 
			    TOPN(
			        3,
			        SUMMARIZE(
			            ALL('Dormidas mensais por segmento (0010735)'[mes]),
			            'Dormidas mensais por segmento (0010735)'[mes]
			        ),
			        CALCULATE(
			            SUM('Dormidas mensais por segmento (0010735)'[dormidas]),
			            'Dormidas mensais por segmento (0010735)'[ano] IN AnosSelecionados
			        ),
			        DESC
			    )
			
			-- 4. Soma as dormidas desses 3 meses específicos do ano filtrado
			VAR DormidasTop3 = 
			    SUMX(
			        TabelaTop3,
			        CALCULATE(
			            SUM('Dormidas mensais por segmento (0010735)'[dormidas]),
			            'Dormidas mensais por segmento (0010735)'[ano] IN AnosSelecionados
			        )
			    )
			
			-- 5. Devolve o cálculo final da taxa
			RETURN
			    DIVIDE(DormidasTop3, TotalAno, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d263dd8f-5807-4887-bf9d-b64a994ec80e

	measure 'Indice Sazonalidade Mensal' = ```
			
			-- 1. Captura o valor de dormidas do mês específico que está a ser avaliado na linha do gráfico/tabela
			VAR ValorMesAtual = SUM('Dormidas mensais por segmento (0010735)'[dormidas])
			
			-- 2. Calcula o Total do Ano mantendo os filtros geográficos e de segmento ativos
			VAR TotalAno = 
			    CALCULATE(
			        SUM('Dormidas mensais por segmento (0010735)'[dormidas]),
			        ALLEXCEPT(
			            'Dormidas mensais por segmento (0010735)',
			            'Dormidas mensais por segmento (0010735)'[ano],
			            'Dormidas mensais por segmento (0010735)'[distrito],
			            'Dormidas mensais por segmento (0010735)'[municipio],
			            'Dormidas mensais por segmento (0010735)'[segmento_alojamento]
			        )
			    )
			
			-- 3. Divide o total do ano por 12 para encontrar a média mensal teórica
			VAR MediaMensalIdeal = DIVIDE(TotalAno, 12, 0)
			
			-- 4. Divide o valor do mês real pela média ideal
			RETURN
			    DIVIDE(ValorMesAtual, MediaMensalIdeal, 0)
			```
		lineageTag: d815582b-9136-46cf-8e93-34d5d62343a4

