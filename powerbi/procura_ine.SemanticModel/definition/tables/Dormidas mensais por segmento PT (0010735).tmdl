table 'Dormidas mensais por segmento PT (0010735)'
	lineageTag: 9438e4bd-9950-4566-a93c-eb917f282e67

	measure 'Taxa de Sazonalidade' = ```
			
			-- 1. Captura os anos selecionados na tabela de filtros exterior
			VAR AnosSelecionados = VALUES(Ano[Ano])
			
			-- 2. Calcula o Total do Ano respeitando o filtro de Ano exterior e os filtros geográficos
			VAR TotalAno = 
			    CALCULATE(
			        SUM('Dormidas mensais por segmento PT (0010735)'[dormidas]),
			        ALL('Dormidas mensais por segmento PT (0010735)'[mes]),
			        'Dormidas mensais por segmento PT (0010735)'[ano] IN AnosSelecionados
			    )
			
			-- 3. Cria a tabela virtual para encontrar os 3 maiores meses considerando o ano filtrado
			VAR TabelaTop3 = 
			    TOPN(
			        3,
			        SUMMARIZE(
			            ALL('Dormidas mensais por segmento PT (0010735)'[mes]),
			            'Dormidas mensais por segmento PT (0010735)'[mes]
			        ),
			        CALCULATE(
			            SUM('Dormidas mensais por segmento PT (0010735)'[dormidas]),
			            'Dormidas mensais por segmento PT (0010735)'[ano] IN AnosSelecionados
			        ),
			        DESC
			    )
			
			-- 4. Soma as dormidas desses 3 meses específicos do ano filtrado
			VAR DormidasTop3 = 
			    SUMX(
			        TabelaTop3,
			        CALCULATE(
			            SUM('Dormidas mensais por segmento PT (0010735)'[dormidas]),
			            'Dormidas mensais por segmento PT (0010735)'[ano] IN AnosSelecionados
			        )
			    )
			
			-- 5. Devolve o cálculo final da taxa
			RETURN
			    DIVIDE(DormidasTop3, TotalAno, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7ccdcf50-ee40-4357-a88a-bbd5375ed24b

	measure 'Indice Sazonalidade Mensal PT' = ```
			
			-- 1. Captura o valor de dormidas do mês específico que está a ser avaliado na linha do gráfico/tabela
			VAR ValorMesAtual = SUM('Dormidas mensais por segmento PT (0010735)'[dormidas])
			
			-- 2. Calcula o Total do Ano mantendo os filtros geográficos e de segmento ativos
			VAR TotalAno = 
			    CALCULATE(
			        SUM('Dormidas mensais por segmento PT (0010735)'[dormidas]),
			        ALLEXCEPT(
			            'Dormidas mensais por segmento PT (0010735)',
			            'Dormidas mensais por segmento PT (0010735)'[ano],
			            'Dormidas mensais por segmento PT (0010735)'[distrito],
			            'Dormidas mensais por segmento PT (0010735)'[municipio],
			            'Dormidas mensais por segmento PT (0010735)'[segmento_alojamento]
			        )
			    )
			
			-- 3. Divide o total do ano por 12 para encontrar a média mensal teórica
			VAR MediaMensalIdeal = DIVIDE(TotalAno, 12, 0)
			
			-- 4. Divide o valor do mês real pela média ideal
			RETURN
			    DIVIDE(ValorMesAtual, MediaMensalIdeal, 0)
			```
		lineageTag: 97a29621-5c70-4d71-9b32-9f273f92152a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

