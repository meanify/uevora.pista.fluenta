/// Facto INE 0010736: Hóspedes por município, segmento de alojamento e mês. Origem: public.ine_0010736_ds. Todo o país, só linhas de município. Mantém a linha Total do INE por segmento.
table 'Hóspedes mensais por segmento'
	lineageTag: c2dbe319-32ae-501c-bab6-54860950d5c5

	column segmento_alojamento
		dataType: string
		isHidden
		lineageTag: 833beda2-5d25-545a-8909-107e27521449
		summarizeBy: none
		sourceColumn: segmento_alojamento

	column ano
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4e19b486-203c-5663-abd7-75afb17b2fbd
		summarizeBy: none
		sourceColumn: ano

		annotation SummarizationSetBy = Automatic

	column mes
		dataType: string
		isHidden
		lineageTag: 98af56d1-0b61-5c3b-a1c5-62f058778870
		summarizeBy: none
		sourceColumn: mes

	/// Primeiro dia do mês, usado para ligar ao Calendário.
	column Data
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 1d8f1884-04ed-5404-9d6f-e7a5d232ce65
		summarizeBy: none
		sourceColumn: Data

		annotation UnderlyingDateTimeDataType = Date

	column hospedes
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: 1719810b-635b-5a26-915e-4c1af57eef0d
		summarizeBy: none
		sourceColumn: hospedes

	column update_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 6422a557-0131-5295-a624-f1db315560f0
		summarizeBy: none
		sourceColumn: update_date

		annotation UnderlyingDateTimeDataType = Date

	column GeoKey
		dataType: string
		isHidden
		lineageTag: 97b47ead-bea4-5b0b-b123-da44cf549d50
		summarizeBy: none
		sourceColumn: GeoKey

	partition 'Hóspedes mensais por segmento' = m
		mode: import
		source =
				let
				    Origem = PostgreSQL.Database(Servidor, BaseDados),
				    Tabela = Origem{[Schema = "public", Item = "ine_0010736_ds"]}[Data],
				    Municipios = Table.SelectRows(Tabela, each [municipio] <> "Total"),
				    ComData = Table.AddColumn(Municipios, "Data", each #date([ano], Number.FromText([mes]), 1), type date),
				    GeoKey = Table.AddColumn(ComData, "GeoKey", each [nuts_i] & "|" & [nuts_ii] & "|" & [nuts_iii] & "|" & [distrito] & "|" & [municipio], type text),
				    Colunas = Table.SelectColumns(GeoKey, {"segmento_alojamento", "ano", "mes", "Data", "hospedes", "update_date", "GeoKey"})
				in
				    Colunas

	annotation PBI_ResultType = Table
