/// Facto INE 0009183: Dormidas por município, local de residência e ano. Origem: public.ine_0009183_ds. Todo o país, só linhas de município.
table 'Dormidas por país de residência'
	lineageTag: 6da3215c-ad39-5d8d-8fb9-28725914478a

	column local_residencia
		dataType: string
		isHidden
		lineageTag: f32072d4-917a-543b-9455-3a8bb1a2f1d4
		summarizeBy: none
		sourceColumn: local_residencia

	column ano
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8fb4712c-bd7d-5539-bee2-2546bd8db1ac
		summarizeBy: none
		sourceColumn: ano

	column dormidas
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: 6ea4397f-b14a-55e6-8c1f-874c4591e36d
		summarizeBy: none
		sourceColumn: dormidas

	column update_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: fcecf525-3197-5c08-b5c8-12f90f6e42e2
		summarizeBy: none
		sourceColumn: update_date

		annotation UnderlyingDateTimeDataType = Date

	column GeoKey
		dataType: string
		isHidden
		lineageTag: f1c418fc-cd6f-5db1-9618-bef7f5ecbab6
		summarizeBy: none
		sourceColumn: GeoKey

	partition 'Dormidas por país de residência' = m
		mode: import
		source =
				let
				    Origem = PostgreSQL.Database(Servidor, BaseDados),
				    Tabela = Origem{[Schema = "public", Item = "ine_0009183_ds"]}[Data],
				    Municipios = Table.SelectRows(Tabela, each [municipio] <> "Total"),
				    GeoKey = Table.AddColumn(Municipios, "GeoKey", each [nuts_i] & "|" & [nuts_ii] & "|" & [nuts_iii] & "|" & [distrito] & "|" & [municipio], type text),
				    Colunas = Table.SelectColumns(GeoKey, {"local_residencia", "ano", "dormidas", "update_date", "GeoKey"})
				in
				    Colunas

	annotation PBI_ResultType = Table
