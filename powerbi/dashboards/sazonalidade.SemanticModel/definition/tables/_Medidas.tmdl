/// Todas as medidas do modelo, organizadas por pastas. As tabelas de factos ficam ocultas: filtrar sempre pelas dimensões.
table _Medidas
	lineageTag: e5605908-5b6a-562f-9e25-209ca406dee6

	/// Superfície em km² (INE 0008350). Para rácios por km² use [SuperficieKm2UltimoAno].
	measure SuperficieKm2 = SUM('Superfície das unidades territoriais'[superficie_unidades_territoriais])
		formatString: #,0.00
		displayFolder: Território
		lineageTag: 9ad9132b-06b3-535f-9148-eb3343877832

	/// Último ano com superfície publicada (2022 enquanto o INE não publicar a série NUTS-2024). É o ano que todas as medidas «por km²» usam.
	measure AnoSuperficie =
			MAXX(
			    FILTER(
			        CALCULATETABLE(VALUES('Ano'[Ano]), REMOVEFILTERS('Ano')),
			        NOT ISBLANK([SuperficieKm2])
			    ),
			    'Ano'[Ano]
			)
		formatString: #,0
		displayFolder: Território
		lineageTag: 616b1de6-1ea3-5f2f-abd3-99ff8673b8c3

	/// Superfície do último ano publicado, independente do ano selecionado. Denominador de todas as medidas «por km²».
	measure SuperficieKm2UltimoAno =
			VAR AnoArea = [AnoSuperficie]
			RETURN
			    CALCULATE(
			        [SuperficieKm2],
			        REMOVEFILTERS('Ano'),
			        'Ano'[Ano] = AnoArea
			    )
		formatString: #,0.00
		displayFolder: Território
		lineageTag: cb7cba61-57d1-50a0-b7c0-673c7fa492ba

	/// Estabelecimentos de alojamento turístico (INE 0009873). Usa a linha agregada do INE quando visível (sem filtro de 'Tipo de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure Estabelecimentos =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Estabelecimentos de alojamento turístico'[establecimento_de_alojamento_turistico]), KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Oferta
		lineageTag: dc172d73-e587-5dee-982c-7f9d6d2c34f1

	/// [Estabelecimentos] com o item «Variação face ao ano base» (ano anterior por omissão). Mantida por estar ligada a visuais; para novos visuais use o item diretamente.
	measure EstabelecimentosYoY = CALCULATE([Estabelecimentos], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
		formatString: 0.0%
		displayFolder: Oferta
		lineageTag: 527bbe52-7cfe-56d9-9260-606f7a1bc0b7

	/// Quartos em alojamento turístico (INE 0009874). Usa a linha agregada do INE quando visível (sem filtro de 'Tipo de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure Quartos =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Quartos em alojamento turístico'[quartos]), KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Oferta
		lineageTag: 3f891145-37cc-5377-8b64-7367c36567d4

	/// Dimensão média dos estabelecimentos: quartos ÷ estabelecimentos.
	measure QuartosPorEstabelecimento = DIVIDE([Quartos], [Estabelecimentos])
		formatString: #,0.00
		displayFolder: Oferta
		lineageTag: a0ce9310-df2b-5ccc-915b-e1311766ae43

	/// Capacidade anual: quartos × dias do ano, somada ano a ano para suportar várias seleções de ano.
	measure NoitesQuartoDisponiveis =
			SUMX(
			VALUES('Ano'[Ano]),
			CALCULATE([Quartos])
			* (DATEDIFF(DATE('Ano'[Ano], 1, 1), DATE('Ano'[Ano], 12, 31), DAY) + 1)
			)
		formatString: #,0
		displayFolder: Oferta
		lineageTag: c2b7a7f0-db22-5699-b13a-dc83f75f6347

	/// Dormidas mensais por segmento de alojamento (INE 0010735). Usa a linha agregada do INE quando visível (sem filtro de 'Segmento de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure DormidasMensaisSegmento =
			VAR Nivel = MIN('Segmento de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Dormidas mensais por segmento'[dormidas]), KEEPFILTERS('Segmento de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Dormidas
		lineageTag: a268ad13-78e4-5e06-9d9f-43b8fe8de328

	/// Dormidas mensais por tipo de alojamento, ao nível NUTS II (INE 0009808, NUTS 2013). Usa a linha agregada do INE quando visível (sem filtro de 'Tipo de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure DormidasMensaisTipo =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Dormidas mensais por tipo de alojamento (NUTS 2013)'[dormidas]), KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Dormidas
		lineageTag: d0057902-5608-50b1-94e0-481d88842526

	/// Dormidas por país de residência (INE 0009183). Usa a linha agregada do INE quando visível (sem filtro de 'Residência': o Total publicado) e as categorias detalhadas quando filtradas.
	measure DormidasResidencia =
			VAR Nivel = MIN('Residência'[Nível])
			RETURN
			    CALCULATE(SUM('Dormidas por país de residência'[dormidas]), KEEPFILTERS('Residência'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Dormidas
		lineageTag: c4005a35-3408-5f11-b166-1ef125748a1e

	/// [DormidasResidencia] com o item «Valor no ano base» (ano anterior por omissão). Mantida por estar ligada a visuais.
	measure DormidasResidenciaAnoAnterior = CALCULATE([DormidasResidencia], 'Comparação temporal'[Período de comparação] = "Valor no ano base")
		formatString: #,0
		displayFolder: Procura\Dormidas
		lineageTag: 43c2a091-5469-511c-9206-7c37718e0d46

	/// [DormidasResidencia] com o item «Variação face ao ano base» (ano anterior por omissão). Mantida por estar ligada a visuais; para novos visuais use o item diretamente.
	measure DormidasResidenciaYoY = CALCULATE([DormidasResidencia], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
		formatString: 0.0%
		displayFolder: Procura\Dormidas
		lineageTag: bc7061e7-7b91-5bd3-897c-67c9e50c9906

	/// Dormidas por tipo de alojamento (INE 0009877). Usa a linha agregada do INE quando visível (sem filtro de 'Tipo de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure DormidasTipo =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Dormidas por tipo de alojamento'[dormidas]), KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Dormidas
		lineageTag: 7c358e0e-b7ef-548e-9018-8cb4a0df9d84

	/// [DormidasTipo] com o item «Variação face ao ano base» (ano anterior por omissão). Mantida por estar ligada a visuais; para novos visuais use o item diretamente.
	measure DormidasTipoYoY = CALCULATE([DormidasTipo], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
		formatString: 0.0%
		displayFolder: Procura\Dormidas
		lineageTag: 5f334fff-3cc3-54c4-a0d8-1281fc66faaf

	/// Hóspedes mensais por segmento de alojamento (INE 0010736). Usa a linha agregada do INE quando visível (sem filtro de 'Segmento de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure HospedesMensaisSegmento =
			VAR Nivel = MIN('Segmento de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Hóspedes mensais por segmento'[hospedes]), KEEPFILTERS('Segmento de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Hóspedes
		lineageTag: bb8c4665-bf05-5bf4-b2eb-8e37f334c32b

	/// Hóspedes mensais por tipo de alojamento, ao nível NUTS II (INE 0009812, NUTS 2013). Usa a linha agregada do INE quando visível (sem filtro de 'Tipo de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure HospedesMensaisTipo =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Hóspedes mensais por tipo de alojamento (NUTS 2013)'[hospedes]), KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Hóspedes
		lineageTag: 3bfceae4-55c4-5020-bf4e-ee66f1023b53

	/// Hóspedes mensais por tipo de alojamento, ao nível NUTS II (INE 0012093, NUTS 2024). Usa a linha agregada do INE quando visível (sem filtro de 'Tipo de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure HospedesMensaisTipoNuts2024 =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Hóspedes mensais por tipo de alojamento (NUTS 2024)'[hospedes]), KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Hóspedes
		lineageTag: 560b6248-3a76-56f1-afcd-a3ff6eae92b1

	/// Hóspedes por país de residência (INE 0009930). Usa a linha agregada do INE quando visível (sem filtro de 'Residência': o Total publicado) e as categorias detalhadas quando filtradas.
	measure HospedesResidencia =
			VAR Nivel = MIN('Residência'[Nível])
			RETURN
			    CALCULATE(SUM('Hóspedes por país de residência'[hospedes]), KEEPFILTERS('Residência'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Hóspedes
		lineageTag: d2fe82ac-0194-5953-90a9-71d09de457b4

	/// [HospedesResidencia] com o item «Valor no ano base» (ano anterior por omissão). Mantida por estar ligada a visuais.
	measure HospedesResidenciaAnoAnterior = CALCULATE([HospedesResidencia], 'Comparação temporal'[Período de comparação] = "Valor no ano base")
		formatString: #,0
		displayFolder: Procura\Hóspedes
		lineageTag: 41b1bf84-c0b2-5ea8-8ded-fb9c7607599f

	/// [HospedesResidencia] com o item «Variação face ao ano base» (ano anterior por omissão). Mantida por estar ligada a visuais; para novos visuais use o item diretamente.
	measure HospedesResidenciaYoY = CALCULATE([HospedesResidencia], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
		formatString: 0.0%
		displayFolder: Procura\Hóspedes
		lineageTag: c5cfe5c4-e0d2-5e6b-8c97-84d21d6ccd9a

	/// Hóspedes por tipo de alojamento (INE 0009876). Usa a linha agregada do INE quando visível (sem filtro de 'Tipo de alojamento': o Total publicado) e as categorias detalhadas quando filtradas.
	measure HospedesTipo =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			RETURN
			    CALCULATE(SUM('Hóspedes por tipo de alojamento'[hospedes]), KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel))
		formatString: #,0
		displayFolder: Procura\Hóspedes
		lineageTag: 79025c97-231f-5060-9495-db51da0c57ea

	/// Estada média por local de residência: dormidas ÷ hóspedes (0009183 ÷ 0009930), recalculada em qualquer agregação.
	measure EstadaMediaResidencia = DIVIDE([DormidasResidencia], [HospedesResidencia])
		formatString: #,0.00
		displayFolder: Procura\Estada média
		lineageTag: 650f9b8f-106b-579f-88b6-4e601084fbc6

	/// [EstadaMediaResidencia] com o item «Valor no ano base» (ano anterior por omissão). Mantida por estar ligada a visuais.
	measure EstadaMediaResidenciaAnoAnterior = CALCULATE([EstadaMediaResidencia], 'Comparação temporal'[Período de comparação] = "Valor no ano base")
		formatString: #,0.00
		displayFolder: Procura\Estada média
		lineageTag: e921c615-1965-5380-a7a0-ca3737ddfdf6

	/// [EstadaMediaResidencia] com o item «Variação face ao ano base» (ano anterior por omissão). Mantida por estar ligada a visuais; para novos visuais use o item diretamente.
	measure EstadaMediaResidenciaYoY = CALCULATE([EstadaMediaResidencia], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
		formatString: 0.0%
		displayFolder: Procura\Estada média
		lineageTag: ec81fe1c-140b-50b2-9619-8c217d2c623f

	/// Estada média: dormidas ÷ hóspedes (0009877 ÷ 0009876), recalculada em qualquer agregação. Substitui a média da estada publicada.
	measure EstadaMediaTipo = DIVIDE([DormidasTipo], [HospedesTipo])
		formatString: #,0.00
		displayFolder: Procura\Estada média
		lineageTag: c33973fd-cb73-5b8e-8212-aa5eecd907b9

	/// Dormidas mensais ÷ hóspedes mensais por segmento.
	measure EstadaMediaMensalSegmento = DIVIDE([DormidasMensaisSegmento], [HospedesMensaisSegmento])
		formatString: #,0.00
		displayFolder: Procura\Estada média
		lineageTag: 78b54416-8d19-5562-b74d-62f058b8104a

	/// RevPAR (€) publicado pelo INE (0009929) por município e categoria. Acima do município é a média ponderada pelos quartos da mesma categoria e ano; os rácios nunca se somam.
	measure RevPAR =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			VAR Linhas =
			    CALCULATETABLE(
			        SUMMARIZE('Rendimento médio por quarto', 'Geografia'[GeoKey], 'Tipo de alojamento'[TipoKey], 'Ano'[Ano]),
			        KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel)
			    )
			VAR Pares =
			    ADDCOLUMNS(
			        Linhas,
			        "@RevPAR", CALCULATE(SUM('Rendimento médio por quarto'[rendimento_medio_por_quarto])),
			        "@Quartos", CALCULATE(SUM('Quartos em alojamento turístico'[quartos]))
			    )
			VAR Validos = FILTER(Pares, NOT ISBLANK([@RevPAR]) && [@Quartos] > 0)
			RETURN DIVIDE(SUMX(Validos, [@RevPAR] * [@Quartos]), SUMX(Validos, [@Quartos]))
		formatString: #,0.00 "€"
		displayFolder: Desempenho
		lineageTag: 357e2400-316f-5b1a-90e5-5363a73d604a

	/// [RevPAR] com o item «Variação face ao ano base» (ano anterior por omissão). Mantida por estar ligada a visuais; para novos visuais use o item diretamente.
	measure RevPARYoY = CALCULATE([RevPAR], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
		formatString: 0.0%
		displayFolder: Desempenho
		lineageTag: b8f1cb37-ac73-573c-850a-2654a9ba30fe

	/// Aproximação à ocupação: dormidas ÷ noites-quarto disponíveis. As dormidas do INE são noites de hóspede, não de quarto, pelo que um quarto partilhado conta mais do que uma vez e o valor pode passar os 100%. Serve para comparar municípios, não como taxa de ocupação oficial.
	measure OcupacaoEstimada = DIVIDE([DormidasTipo], [NoitesQuartoDisponiveis])
		formatString: 0.0%
		displayFolder: Desempenho
		lineageTag: c4f7a5d3-74b6-5275-ad3b-2cc5054f9838

	/// Intensidade turística: dormidas anuais por quilómetro quadrado. A área é a do último ano publicado, não a do ano selecionado.
	measure DormidasPorKm2 = DIVIDE([DormidasTipo], [SuperficieKm2UltimoAno])
		formatString: #,0.00
		displayFolder: Pressão turística
		lineageTag: f890f8f2-b1fa-54d6-88a2-0ddd9fcbf120

	/// Hóspedes anuais por km² (área do último ano publicado).
	measure HospedesPorKm2 = DIVIDE([HospedesTipo], [SuperficieKm2UltimoAno])
		formatString: #,0.00
		displayFolder: Pressão turística
		lineageTag: af3c434d-fa94-5ea8-ba2c-7f96975087d6

	/// Capacidade licenciada por quilómetro quadrado. Ler ao lado de [DormidasPorKm2] para separar carga de capacidade.
	measure QuartosPorKm2 = DIVIDE([Quartos], [SuperficieKm2UltimoAno])
		formatString: #,0.00
		displayFolder: Pressão turística
		lineageTag: d8d59c02-d6a9-5b1d-8ce0-0e73569ec30b

	/// Estabelecimentos por km² (área do último ano publicado).
	measure EstabelecimentosPorKm2 = DIVIDE([Estabelecimentos], [SuperficieKm2UltimoAno])
		formatString: #,0.00
		displayFolder: Pressão turística
		lineageTag: 7ff64df2-e85a-57e7-b6e1-31ad345e902e

	/// Posição relativa do município em foco na distribuição de dormidas por km² dos municípios da região filtrada (página). Mostrar com [MunicipiosComDadosPressao].
	measure PercentilPressao =
			VAR SelKey = SELECTEDVALUE('Município selecionado'[GeoKey])
			VAR Valores =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES('Geografia'[GeoKey]), REMOVEFILTERS('Geografia')),
			        "@Valor",
			            VAR Chave = 'Geografia'[GeoKey]
			            RETURN CALCULATE([DormidasPorKm2], REMOVEFILTERS('Geografia'), 'Geografia'[GeoKey] = Chave)
			    )
			VAR ComDados = FILTER(Valores, NOT ISBLANK([@Valor]))
			VAR ValorSel = MAXX(FILTER(ComDados, 'Geografia'[GeoKey] = SelKey), [@Valor])
			RETURN IF(NOT ISBLANK(ValorSel), DIVIDE(COUNTROWS(FILTER(ComDados, [@Valor] < ValorSel)), COUNTROWS(ComDados)))
		formatString: 0.0%
		displayFolder: Pressão turística
		lineageTag: 264eeccd-5822-534c-9799-6a7b7057da02

	/// Métrica do mapa de pressão, escolhida na tabela desligada.
	measure PressaoMetricaSelecionada =
			SWITCH(
			    SELECTEDVALUE('Métrica de pressão'[Métrica], "Dormidas por km²"),
			    "Hóspedes por km²", [HospedesPorKm2],
			    [DormidasPorKm2]
			)
		formatString: #,0.00
		displayFolder: Pressão turística
		lineageTag: aa1aeea4-3c12-5bb6-ad57-09b388111bcb

	/// Quantos municípios da região filtrada publicam dormidas por km². Denominador de [PercentilPressao].
	measure MunicipiosComDadosPressao =
			VAR Municipios = CALCULATETABLE(VALUES('Geografia'[GeoKey]), REMOVEFILTERS('Geografia'))
			RETURN
			    COUNTROWS(
			        FILTER(
			            Municipios,
			            VAR Chave = 'Geografia'[GeoKey]
			            RETURN NOT ISBLANK(CALCULATE([DormidasPorKm2], REMOVEFILTERS('Geografia'), 'Geografia'[GeoKey] = Chave))
			        )
			    )
		formatString: #,0
		displayFolder: Pressão turística
		lineageTag: 70a67312-3fbb-580f-9da2-c43cb8ff6543

	/// Peso dos três meses com mais dormidas no total anual dos anos selecionados (0–100%). Mantém os filtros de geografia e segmento.
	measure TaxaSazonalidade =
			VAR AnosSelecionados = VALUES('Ano'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        AnosSelecionados
			    )
			VAR TotalAno = SUMX(PorMes, [@Dormidas])
			VAR Top3Meses = SUMX(TOPN(3, PorMes, [@Dormidas], DESC), [@Dormidas])
			RETURN DIVIDE(Top3Meses, TotalAno)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sazonalidade
		lineageTag: d263dd8f-5807-4887-bf9d-b64a994ec80e

	/// Dormidas do mês em índice, mês máximo do ano = 100 (calendário de pressão). Usar com 'Calendário'[Mês] e 'Ano'[Ano] numa matriz.
	measure IndiceSazonalidadeMensal =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			RETURN DIVIDE([DormidasMensaisSegmento], MAXX(Meses, [@Dormidas])) * 100
		displayFolder: Sazonalidade
		formatString: #,0
		lineageTag: d815582b-9136-46cf-8e93-34d5d62343a4

	/// [TaxaSazonalidade] para todo o país. Equivale ao item «Portugal» de 'Comparação territorial'; mantém-se porque os cartões da página Sazonalidade a usam.
	measure TaxaSazonalidadePortugal = CALCULATE([TaxaSazonalidade], REMOVEFILTERS('Geografia'), REMOVEFILTERS('Região NUTS II'))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sazonalidade
		lineageTag: 7ccdcf50-ee40-4357-a88a-bbd5375ed24b

	/// Mês de pico ÷ média mensal no último ano civil completo ([AnoCompletoMaisRecente]); um ano cortado a meio empolaria o pico.
	measure IndiceSazonalidadePico =
			VAR AnoCompleto = [AnoCompletoMaisRecente]
			RETURN
			    CALCULATE(
			        VAR PorMes = ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento])
			        RETURN DIVIDE(MAXX(PorMes, [@Dormidas]), AVERAGEX(PorMes, [@Dormidas])),
			        REMOVEFILTERS('Calendário'),
			        'Calendário'[Ano] = AnoCompleto
			    )
		formatString: #,0.00
		displayFolder: Sazonalidade
		lineageTag: 861ed44b-53ea-5219-af38-af5e00319245

	/// O ano que o índice de sazonalidade usa. Mostrar no título do painel.
	measure AnoCompletoMaisRecente =
			MAXX(
			    FILTER(
			        CALCULATETABLE(VALUES('Calendário'[Ano]), REMOVEFILTERS('Calendário')),
			        CALCULATE(
			            COUNTROWS(
			                FILTER(
			                    VALUES('Calendário'[Mês]),
			                    NOT ISBLANK([DormidasMensaisSegmento])
			                )
			            )
			        ) = 12
			    ),
			    'Calendário'[Ano]
			)
		formatString: #,0
		displayFolder: Sazonalidade
		lineageTag: a2183068-8b20-51ed-860d-6e9bcab7ff67

