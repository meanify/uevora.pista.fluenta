	/// [EstadaMediaTipo] com o item «Média dos pares» de 'Comparação entre pares'. Mantida por estar ligada a visuais.
	measure MediaParesEstadaMedia = CALCULATE([EstadaMediaTipo], 'Comparação entre pares'[Cálculo entre pares] = "Média dos pares")
		formatString: #,0.00
