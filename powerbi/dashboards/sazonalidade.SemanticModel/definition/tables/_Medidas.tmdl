	/// Dourado no município em foco, azul nos pares. Ligar ao «Field value» da cor das barras; exige 'Geografia'[Município] no eixo.
	measure CorMunicipioEmFoco =
			IF(
			    SELECTEDVALUE('Geografia'[GeoKey]) = SELECTEDVALUE('Município selecionado'[GeoKey]),
			    "#FFAD00",
			    "#2066BC"
			)
		displayFolder: Formatação\Cores
		lineageTag: 6d385a78-6096-580c-b389-3e63bde005d6

	/// Cor totalmente transparente, para fundos e contornos condicionais.
	measure CorTransparente = "rgba(0,0,0,0)"
		displayFolder: Formatação\Cores
		lineageTag: 169bceb7-9232-46bc-b225-007ca755a4df

	/// Dourado na sub-região em foco, azul nas outras. Ligar ao «Field value» da cor das barras; exige 'Geografia'[NUTS III] no eixo.
	measure CorSubRegiaoEmFoco =
			IF(
			    SELECTEDVALUE('Geografia'[NUTS III])
			        = SELECTEDVALUE('Sub-região em foco'[NUTS III]),
			    "#FFAD00",
			    "#2066BC"
			)
		displayFolder: Formatação\Cores
		lineageTag: 2f7c56fc-904d-5d97-9c37-3460734c399d

	/// Região · município em foco · grupo de pares · ano, para o cabeçalho da página A.
	measure SubtituloQuadroComparativo =
			VAR Regiao = SELECTEDVALUE('Região NUTS II'[NUTS II], "várias regiões")
			VAR Mun = SELECTEDVALUE('Município selecionado'[Município], "município por escolher")
			VAR Pares = SELECTEDVALUE('Geografia'[NUTS III], "todos os pares")
			VAR AnoSel = SELECTEDVALUE('Ano'[Ano])
			RETURN
			    Regiao & " · " & Mun & " · " & Pares & " · "
			        & IF(ISBLANK(AnoSel), "todos os anos", FORMAT(AnoSel, "0"))
		displayFolder: Formatação\Subtítulos
		lineageTag: 037b2978-5352-5ab8-82f1-ac67720732e0

	/// Região · métrica escolhida · ano, para o cabeçalho da página B.
	measure SubtituloPressaoTuristica =
			VAR Regiao = SELECTEDVALUE('Região NUTS II'[NUTS II], "várias regiões")
			VAR Metrica = SELECTEDVALUE('Métrica de pressão'[Métrica], "Dormidas por km²")
			VAR AnoSel = SELECTEDVALUE('Ano'[Ano])
			RETURN
			    Regiao & " · " & Metrica & " · "
			        & IF(ISBLANK(AnoSel), "todos os anos", FORMAT(AnoSel, "0"))
		displayFolder: Formatação\Subtítulos
		lineageTag: b21ef53f-b556-557a-bad4-0767968d5a3a

	/// Região · intervalo de anos publicado, para o cabeçalho da página C.
	measure SubtituloSazonalidade =
			VAR Regiao = SELECTEDVALUE('Região NUTS II'[NUTS II], "várias regiões")
			VAR AnoMin = MIN('Calendário'[Ano])
			VAR AnoMax = MAX('Calendário'[Ano])
			RETURN
			    Regiao & " · Dormidas mensais · " & FORMAT(AnoMin, "0") & " – " & FORMAT(AnoMax, "0")
		displayFolder: Formatação\Subtítulos
		lineageTag: ca876803-343c-5064-8e25-814676913fef

	/// Dormidas ÷ hóspedes mensais por NUTS II (0009808 ÷ 0009812). Posicionamento entre regiões.
	measure EstadaMediaMensalTipo = DIVIDE([DormidasMensaisTipo], [HospedesMensaisTipo])
		formatString: #,0.00
		displayFolder: Procura\Estada média
		lineageTag: db1f4f0f-0c7f-4fc4-9c7d-a77c2e01a610

	/// Peso do tipo de alojamento filtrado nas dormidas totais (Total INE).
	measure QuotaDormidasTipo = DIVIDE([DormidasTipo], CALCULATE([DormidasTipo], REMOVEFILTERS('Tipo de alojamento'), REMOVEFILTERS('Segmento de alojamento')))
		formatString: 0.0%
		displayFolder: Procura\Dormidas
		lineageTag: f4d812c8-4844-4657-8b3a-c487735ef0c3

	/// Peso do tipo de alojamento filtrado nos quartos totais (Total INE): peso do AL, do TER, mix de tipologias.
	measure QuotaQuartosTipo = DIVIDE([Quartos], CALCULATE([Quartos], REMOVEFILTERS('Tipo de alojamento'), REMOVEFILTERS('Segmento de alojamento')))
		formatString: 0.0%
		displayFolder: Oferta
		lineageTag: 27b0f55c-ce0b-45a5-af4f-aec99a727edd

	/// Hóspedes ÷ estabelecimentos.
	measure HospedesPorEstabelecimento = DIVIDE([HospedesTipo], [Estabelecimentos])
		formatString: #,0
		displayFolder: Oferta
		lineageTag: 954757b8-1b28-43ef-8191-0e9a4e26b32d

	/// Indicador de referência: dormidas ÷ quartos, por ano. Mede o uso da capacidade; não é a taxa de ocupação oficial.
	measure NoitesPorQuarto = DIVIDE([DormidasTipo], [Quartos])
		formatString: #,0.0
		displayFolder: Oferta e procura
		lineageTag: f22b62d7-5ebb-4d27-a033-4a764d2dc9f3

	/// Crescimento das dormidas menos crescimento dos quartos desde o 'Ano base', em p.p. Em branco com menos de 20 quartos no ano base (taxas instáveis).
	measure GapOfertaProcura =
			VAR CrescDormidas = CALCULATE([DormidasTipo], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
			VAR CrescQuartos = CALCULATE([Quartos], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
			VAR QuartosBase = CALCULATE([Quartos], 'Comparação temporal'[Período de comparação] = "Valor no ano base")
			RETURN
			    IF(
			        QuartosBase >= 20 && NOT ISBLANK(CrescDormidas) && NOT ISBLANK(CrescQuartos),
			        (CrescDormidas - CrescQuartos) * 100
			    )
		formatString: +#,0.0;-#,0.0;0.0
		displayFolder: Oferta e procura
		lineageTag: 1117e921-1871-4cc6-a80f-0d684e894aa9

	/// Estimativa: RevPAR × quartos × 365, somada por município e categoria. Assume RevPAR diário por quarto disponível; cobre só os municípios com RevPAR publicado.
	measure ReceitaEstimadaAlojamento =
			VAR Nivel = MIN('Tipo de alojamento'[Nível])
			VAR Linhas =
			    CALCULATETABLE(
			        SUMMARIZE('Rendimento médio por quarto', 'Geografia'[GeoKey], 'Tipo de alojamento'[TipoKey], 'Ano'[Ano]),
			        KEEPFILTERS('Tipo de alojamento'[Nível] = Nivel)
			    )
			RETURN
			    SUMX(
			        Linhas,
			        VAR RevPARLinha = CALCULATE(SUM('Rendimento médio por quarto'[rendimento_medio_por_quarto]))
			        VAR QuartosLinha = CALCULATE(SUM('Quartos em alojamento turístico'[quartos]))
			        RETURN IF(NOT ISBLANK(RevPARLinha) && QuartosLinha > 0, RevPARLinha * QuartosLinha * 365)
			    )
		formatString: #,0 €
		displayFolder: Desempenho
		lineageTag: 026d6077-cbe3-4f1c-9346-90f59534d73c

	/// Peso do local de residência filtrado nas dormidas totais. Com 'Tipo de residente' = Residentes é o peso do mercado interno; = Não Residentes é a quota internacional.
	measure QuotaDormidasResidencia = DIVIDE([DormidasResidencia], CALCULATE([DormidasResidencia], REMOVEFILTERS('Residência')))
		formatString: 0.0%
		displayFolder: Mercados
		lineageTag: 164fa8a2-a327-442c-a32e-0ba19a6b9fa1

	/// Peso do local de residência filtrado nos hóspedes totais. Base da especialização face a Portugal e da diferença face à região.
	measure QuotaHospedesResidencia = DIVIDE([HospedesResidencia], CALCULATE([HospedesResidencia], REMOVEFILTERS('Residência')))
		formatString: 0.0%
		displayFolder: Mercados
		lineageTag: abf2f9d9-3bcf-4d2e-8b20-f38d79392cfc

	/// Peso do mercado nas dormidas de não residentes (principais mercados estrangeiros).
	measure QuotaDormidasMercadoEstrangeiro =
			DIVIDE(
			    [DormidasResidencia],
			    CALCULATE([DormidasResidencia], REMOVEFILTERS('Residência'), 'Residência'[Tipo de residente] = "Não Residentes")
			)
		formatString: 0.0%
		displayFolder: Mercados
		lineageTag: eeafe40e-ddc9-4c12-962e-3d0fd06208fd

	/// Concentração dos hóspedes estrangeiros por país (Herfindahl-Hirschman, 0–10 000; abaixo de 1 500 = pouco concentrado).
	measure HHIMercados =
			VAR Mercados = CALCULATETABLE(VALUES('Residência'[Local de residência]), 'Residência'[Mercado individual] = TRUE())
			VAR PorMercado = ADDCOLUMNS(Mercados, "@Hospedes", [HospedesResidencia])
			VAR Total = SUMX(PorMercado, [@Hospedes])
			RETURN IF(Total > 0, SUMX(PorMercado, POWER(DIVIDE([@Hospedes], Total) * 100, 2)))
		formatString: #,0
		displayFolder: Mercados
		lineageTag: 2e152e4d-81ec-4236-b13d-b7ae005c3e42

	/// Peso dos três maiores mercados estrangeiros nos hóspedes não residentes.
	measure PesoTop3Mercados =
			VAR Mercados = CALCULATETABLE(VALUES('Residência'[Local de residência]), 'Residência'[Mercado individual] = TRUE())
			VAR PorMercado = ADDCOLUMNS(Mercados, "@Hospedes", [HospedesResidencia])
			VAR Top3 = SUMX(TOPN(3, PorMercado, [@Hospedes], DESC), [@Hospedes])
			VAR Estrangeiros = CALCULATE([HospedesResidencia], REMOVEFILTERS('Residência'), 'Residência'[Tipo de residente] = "Não Residentes")
			RETURN DIVIDE(Top3, Estrangeiros)
		formatString: 0%
		displayFolder: Mercados
		lineageTag: 407b4c80-6590-4b40-99fc-0778ba19ba57

	/// Variação dos hóspedes face ao 'Ano base' (ano anterior por omissão). Eixo X da matriz de mercados.
	measure CrescimentoHospedesMercado = CALCULATE([HospedesResidencia], 'Comparação temporal'[Período de comparação] = "Variação face ao ano base")
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Mercados
		lineageTag: 0a74eabe-3122-4381-908e-f258b73ed859

	/// Quantos dos 8 maiores mercados estrangeiros (por hóspedes) crescem face ao 'Ano base'. Mostrar como «N de 8».
	measure MercadosEmCrescimento =
			VAR Mercados = CALCULATETABLE(VALUES('Residência'[Local de residência]), 'Residência'[Mercado individual] = TRUE())
			VAR PorMercado = FILTER(ADDCOLUMNS(Mercados, "@Hospedes", [HospedesResidencia]), NOT ISBLANK([@Hospedes]))
			VAR Top8 = TOPN(8, PorMercado, [@Hospedes], DESC)
			RETURN COUNTROWS(FILTER(Top8, CALCULATE([CrescimentoHospedesMercado]) > 0)) + 0
		formatString: #,0
		displayFolder: Mercados
		lineageTag: fd1305ba-104a-4b91-8e26-1d52681e4f38

	/// Crescimento de todos os hóspedes do território (linha de referência vertical da matriz de mercados).
	measure ReferenciaCrescimentoHospedes = CALCULATE([CrescimentoHospedesMercado], REMOVEFILTERS('Residência'))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Mercados
		lineageTag: 04746037-4762-48f3-b4ea-22cb3685e417

	/// Estada média de todos os hóspedes do território (linha de referência horizontal da matriz de mercados).
	measure ReferenciaEstadaMedia = CALCULATE([EstadaMediaResidencia], REMOVEFILTERS('Residência'))
		formatString: #,0.00
		displayFolder: Mercados
		lineageTag: 86219205-b806-49f8-b8b0-e20f6f81c131

	/// Estrelas, De passagem, Fiéis ou A rever: crescimento e estada do mercado face às referências do território.
	measure QuadranteMercado =
			VAR Crescimento = [CrescimentoHospedesMercado]
			VAR Estada = [EstadaMediaResidencia]
			VAR RefCrescimento = [ReferenciaCrescimentoHospedes]
			VAR RefEstada = [ReferenciaEstadaMedia]
			RETURN
			    IF(
			        NOT ISBLANK(Crescimento) && NOT ISBLANK(Estada) && NOT ISBLANK(RefCrescimento) && NOT ISBLANK(RefEstada),
			        IF(
			            Crescimento >= RefCrescimento,
			            IF(Estada >= RefEstada, "Estrelas", "De passagem"),
			            IF(Estada >= RefEstada, "Fiéis", "A rever")
			        )
			    )
		displayFolder: Mercados
		lineageTag: 1e981679-afe8-484d-8ad2-22771137279a

	/// Peso do mês nas dormidas do seu ano (perfil mensal). Com 'Comparação territorial' compara concelho, região e Portugal.
	measure QuotaMesDormidas = DIVIDE([DormidasMensaisSegmento], CALCULATE([DormidasMensaisSegmento], REMOVEFILTERS('Calendário'), VALUES('Calendário'[Ano])))
		formatString: 0.0%
		displayFolder: Sazonalidade
		lineageTag: 5f5d6273-7d78-420a-b6a9-36d1dfafac84

	/// Dormidas do mês com mais dormidas nos anos do contexto.
	measure DormidasMesPico =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			RETURN MAXX(Meses, [@Dormidas])
		formatString: #,0
		displayFolder: Sazonalidade
		lineageTag: a4bee835-8306-4924-b07a-8a496c1bba29

	/// Nome do mês com mais dormidas nos anos do contexto.
	measure MesPicoDormidas =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			VAR Pico = TOPN(1, Meses, [@Dormidas], DESC)
			RETURN IF(NOT ISEMPTY(Meses), FORMAT(DATE(2000, MAXX(Pico, 'Calendário'[Mês]), 1), "mmmm"))
		displayFolder: Sazonalidade
		lineageTag: 239082f4-c235-4cbf-b007-4ba9166fa20a

	/// Nome do mês com menos dormidas; só num ano com os 12 meses publicados.
	measure MesMaisFracoDormidas =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			VAR Vale = TOPN(1, Meses, [@Dormidas], ASC)
			RETURN IF(COUNTROWS(Meses) = 12, FORMAT(DATE(2000, MAXX(Vale, 'Calendário'[Mês]), 1), "mmmm"))
		displayFolder: Sazonalidade
		lineageTag: 151bd549-e0be-4253-ab9c-c316e14ffbea

	/// Mês máximo ÷ mês mínimo do ano (só com os 12 meses). Menor = menos sazonal.
	measure RacioPicoVale =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			RETURN IF(COUNTROWS(Meses) = 12, DIVIDE(MAXX(Meses, [@Dormidas]), MINX(Meses, [@Dormidas])))
		formatString: #,0.0
		displayFolder: Sazonalidade
		lineageTag: 8dad3f06-472d-4a6e-80de-cdc4ccf53d0c

	/// Peso de junho a setembro nas dormidas do ano (só com os 12 meses).
	measure QuotaDormidasJunSet =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			RETURN IF(COUNTROWS(Meses) = 12, DIVIDE(SUMX(FILTER(Meses, 'Calendário'[Mês] >= 6 && 'Calendário'[Mês] <= 9), [@Dormidas]), SUMX(Meses, [@Dormidas])))
		formatString: 0%
		displayFolder: Sazonalidade
		lineageTag: 1d70da30-c870-42e5-a8be-6750de93344b

	/// Peso de julho a setembro nas dormidas do ano (só com os 12 meses).
	measure QuotaDormidasJulSet =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			RETURN IF(COUNTROWS(Meses) = 12, DIVIDE(SUMX(FILTER(Meses, 'Calendário'[Mês] >= 7 && 'Calendário'[Mês] <= 9), [@Dormidas]), SUMX(Meses, [@Dormidas])))
		formatString: 0%
		displayFolder: Sazonalidade
		lineageTag: dcd35c2e-72a4-4028-9c40-1552b8912481

	/// Coeficiente de Gini das dormidas pelos 12 meses (0 = distribuição igual). Só com os 12 meses.
	measure GiniMensal =
			VAR Anos = VALUES('Calendário'[Ano])
			VAR PorMes =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Calendário'[Mês]), "@Dormidas", [DormidasMensaisSegmento]),
			        REMOVEFILTERS('Calendário'),
			        Anos
			    )
			VAR Meses = FILTER(PorMes, NOT ISBLANK([@Dormidas]))
			VAR N = COUNTROWS(Meses)
			VAR Total = SUMX(Meses, [@Dormidas])
			VAR Diferencas = SUMX(Meses, VAR Valor = [@Dormidas] RETURN SUMX(Meses, ABS(Valor - [@Dormidas])))
			RETURN IF(N = 12 && Total > 0, DIVIDE(Diferencas, 2 * N * Total))
		formatString: 0.00
		displayFolder: Sazonalidade
		lineageTag: cb1d1d7a-e11b-43b6-91e0-1df195fd1900

	/// Ano de comparação em vigor: o escolhido em 'Ano base' ou o ano anterior ao selecionado (um único ano). Para títulos («2019 = 100»).
	measure AnoBase =
			VAR AnoAtual = SELECTEDVALUE('Ano'[Ano])
			RETURN IF(NOT ISBLANK(AnoAtual), COALESCE(SELECTEDVALUE('Ano base'[Ano]), AnoAtual - 1))
		formatString: 0
		displayFolder: Formatação\Subtítulos
		lineageTag: bd069441-bb31-40cc-836a-9d9b79ccbfec

	/// Data da última atualização dos dados INE carregados (rodapé de metadados).
	measure DataAtualizacaoDados =
			CALCULATE(
			    MAXX(
			        {
			            MAX('Dormidas por tipo de alojamento'[update_date]),
			            MAX('Quartos em alojamento turístico'[update_date]),
			            MAX('Hóspedes por país de residência'[update_date]),
			            MAX('Dormidas mensais por segmento'[update_date]),
			            MAX('Dormidas mensais por tipo de alojamento (NUTS 2013)'[update_date])
			        },
			        [Value]
			    ),
			    REMOVEFILTERS()
			)
