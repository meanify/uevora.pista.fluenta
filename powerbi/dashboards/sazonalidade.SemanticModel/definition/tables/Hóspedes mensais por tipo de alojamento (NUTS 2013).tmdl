	partition 'Hóspedes mensais por tipo de alojamento (NUTS 2013)' = m
		mode: import
		source =
				let
				    Origem = PostgreSQL.Database(Servidor, BaseDados),
				    Tabela = Origem{[Schema = "public", Item = "ine_0009812_ds"]}[Data],
				    Regioes = Table.SelectRows(Tabela, each [nuts_ii] <> "Total"),
				    ComData = Table.AddColumn(Regioes, "Data", each #date([ano], Number.FromText([mes]), 1), type date),
				    NutsII = Table.AddColumn(ComData, "NutsIIKey", each [nuts_i] & "|" & [nuts_ii], type text),
				    TipoKey = Table.AddColumn(NutsII, "TipoKey", each [tipo_alojamento] & "|" & [subtipo_alojamento] & "|Total", type text),
				    Colunas = Table.SelectColumns(TipoKey, {"nuts_i", "nuts_ii", "tipo_alojamento", "subtipo_alojamento", "ano", "mes", "Data", "hospedes", "update_date", "NutsIIKey", "TipoKey"})
				in
				    Colunas

	annotation PBI_ResultType = Table
