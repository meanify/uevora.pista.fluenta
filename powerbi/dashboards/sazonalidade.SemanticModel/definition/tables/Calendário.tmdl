/// Calendário diário cobrindo os indicadores mensais. Os factos mensais ligam ao dia 1 de cada mês.
table Calendário
	lineageTag: c48fc1a2-12f5-53e2-a34a-d1803450195f
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		lineageTag: 1d37c00e-8a85-5497-9686-b3bf3704f45b
		summarizeBy: none
		sourceColumn: [Data]

	/// Ano do mês. Para filtrar use 'Ano'[Ano], que também filtra os indicadores anuais.
	column Ano
		dataType: int64
		isHidden
		lineageTag: f29352b0-7141-53a3-b323-aab3fdbb24be
		summarizeBy: none
		sourceColumn: [Ano]

	column Mês
		dataType: int64
		lineageTag: 837e4d74-bf7b-5a40-9006-212d96313c12
		summarizeBy: none
		sourceColumn: [Mês]

	column 'Nome do mês'
		dataType: string
		sortByColumn: Mês
		lineageTag: 22432042-5950-53b8-99e7-ca8535fb05e3
		summarizeBy: none
		sourceColumn: [Nome do mês]

	column Ano-Mês
		dataType: string
		lineageTag: 3f9b0ee0-083b-5c5b-a54c-4662c66b18d6
		summarizeBy: none
		sourceColumn: [Ano-Mês]

	column Trimestre
		dataType: string
		lineageTag: 1d8e49d9-2d00-576f-a950-430f11b9235a
		summarizeBy: none
		sourceColumn: [Trimestre]

	/// «01 - janeiro»: ordena naturalmente e mostra o nome.
	column 'Mês e Nome' = FORMAT('Calendário'[Mês], "00") & " - " & 'Calendário'[Nome do mês]
		lineageTag: 3ea7add8-bdb8-42a8-a994-36e08eb67315
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Calendário = calculated
		mode: import
		source =
				VAR Datas =
				    DISTINCT(
				        UNION(
				            SELECTCOLUMNS('Dormidas mensais por tipo de alojamento (NUTS 2013)', "Data", 'Dormidas mensais por tipo de alojamento (NUTS 2013)'[Data]),
				            SELECTCOLUMNS('Hóspedes mensais por tipo de alojamento (NUTS 2013)', "Data", 'Hóspedes mensais por tipo de alojamento (NUTS 2013)'[Data]),
				            SELECTCOLUMNS('Dormidas mensais por segmento', "Data", 'Dormidas mensais por segmento'[Data]),
				            SELECTCOLUMNS('Hóspedes mensais por segmento', "Data", 'Hóspedes mensais por segmento'[Data]),
				            SELECTCOLUMNS('Hóspedes mensais por tipo de alojamento (NUTS 2024)', "Data", 'Hóspedes mensais por tipo de alojamento (NUTS 2024)'[Data])
				        )
				    )
				// Sem dados mensais (tabelas vazias ou falha no refresh), usa o ano corrente.
				VAR Inicio = DATE(YEAR(COALESCE(MINX(Datas, [Data]), TODAY())), 1, 1)
				VAR Fim = EOMONTH(COALESCE(MAXX(Datas, [Data]), TODAY()), 0)
				RETURN
				    ADDCOLUMNS(
				        SELECTCOLUMNS(CALENDAR(Inicio, Fim), "Data", [Date]),
				        "Ano", YEAR([Data]),
				        "Mês", MONTH([Data]),
				        "Nome do mês", FORMAT([Data], "mmmm"),
				        "Ano-Mês", FORMAT([Data], "yyyy-mm"),
				        "Trimestre", "T" & FORMAT([Data], "q")
				    )
