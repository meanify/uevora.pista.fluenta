ref table 'Segmento de alojamento'
ref table 'Município selecionado'
ref table 'Métrica de pressão'
ref table _Medidas
ref table 'Sub-região em foco'
ref table 'Ano base'
ref table 'Comparação territorial'
ref table 'Comparação temporal'
