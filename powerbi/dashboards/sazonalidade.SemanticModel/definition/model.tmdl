model Model
	culture: pt-PT
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-PT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parâmetros

	annotation PBI_QueryGroupOrder = 0

queryGroup Mapeamentos

	annotation PBI_QueryGroupOrder = 1

annotation PBI_QueryOrder = ["Superfície das unidades territoriais","Dormidas por país de residência","Hóspedes por país de residência","Estabelecimentos de alojamento turístico","Quartos em alojamento turístico","Hóspedes por tipo de alojamento","Dormidas por tipo de alojamento","Rendimento médio por quarto","Dormidas mensais por segmento","Hóspedes mensais por segmento","Dormidas mensais por tipo de alojamento (NUTS 2013)","Hóspedes mensais por tipo de alojamento (NUTS 2013)","Hóspedes mensais por tipo de alojamento (NUTS 2024)","Geografia","Servidor","BaseDados","TerritoriosTuristicos","PeninsulaSetubal"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","WebModelingEdit"]

annotation __LastRPTime = 134377549986899289

ref table 'Superfície das unidades territoriais'
ref table 'Dormidas por país de residência'
