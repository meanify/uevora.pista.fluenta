ref table 'Rendimento médio por quarto'
ref table 'Hóspedes por país de residência'
ref table 'Dormidas mensais por segmento'
ref table 'Hóspedes mensais por segmento'
ref table 'Hóspedes mensais por tipo de alojamento (NUTS 2024)'
ref table Ano
ref table Calendário
ref table Geografia
ref table 'Região NUTS II'
ref table 'Tipo de alojamento'
