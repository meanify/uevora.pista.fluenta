table 'Dormidas por tipo de alojamento (0009877)'
	lineageTag: 61103199-5bf8-5e88-8bae-91c9d8e4413e

	measure 'Dormidas (tipo)' = SUM('Dormidas por tipo de alojamento (0009877)'[dormidas])
		formatString: #,0
		lineageTag: 7c358e0e-b7ef-548e-9018-8cb4a0df9d84

	/// Dormidas do ano anterior. Requer um único ano no contexto de filtro.
	measure 'Dormidas (ano anterior)' =
			VAR AnoAtual = SELECTEDVALUE('Ano'[Ano])
			RETURN
			    IF(
			        NOT ISBLANK(AnoAtual),
			        CALCULATE([Dormidas (tipo)], REMOVEFILTERS('Ano'), 'Ano'[Ano] = AnoAtual - 1)
			    )
		formatString: #,0
		lineageTag: 6eb98aae-b580-54f4-b123-4445d89a55ce

	measure 'Dormidas YoY %' =
			VAR Atual = [Dormidas (tipo)]
			VAR Anterior = [Dormidas (ano anterior)]
			RETURN DIVIDE(Atual - Anterior, Anterior)
		formatString: 0.0%
		lineageTag: 5f334fff-3cc3-54c4-a0d8-1281fc66faaf

