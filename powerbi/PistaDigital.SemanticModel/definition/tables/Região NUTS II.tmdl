	partition 'Região NUTS II' = calculated
		mode: import
		source =
				DISTINCT(
				    UNION(
				        SELECTCOLUMNS('Geografia', "NutsIIKey", 'Geografia'[NutsIIKey], "NUTS I", 'Geografia'[NUTS I], "NUTS II", 'Geografia'[NUTS II]),
				        SELECTCOLUMNS('Dormidas mensais por tipo de alojamento (NUTS 2013) (0009808)', "NutsIIKey", 'Dormidas mensais por tipo de alojamento (NUTS 2013) (0009808)'[NutsIIKey], "NUTS I", 'Dormidas mensais por tipo de alojamento (NUTS 2013) (0009808)'[nuts_i], "NUTS II", 'Dormidas mensais por tipo de alojamento (NUTS 2013) (0009808)'[nuts_ii]),
				        SELECTCOLUMNS('Hóspedes mensais por tipo de alojamento (NUTS 2013) (0009812)', "NutsIIKey", 'Hóspedes mensais por tipo de alojamento (NUTS 2013) (0009812)'[NutsIIKey], "NUTS I", 'Hóspedes mensais por tipo de alojamento (NUTS 2013) (0009812)'[nuts_i], "NUTS II", 'Hóspedes mensais por tipo de alojamento (NUTS 2013) (0009812)'[nuts_ii]),
				        SELECTCOLUMNS('Hóspedes mensais por tipo de alojamento (NUTS 2024) (0012093)', "NutsIIKey", 'Hóspedes mensais por tipo de alojamento (NUTS 2024) (0012093)'[NutsIIKey], "NUTS I", 'Hóspedes mensais por tipo de alojamento (NUTS 2024) (0012093)'[nuts_i], "NUTS II", 'Hóspedes mensais por tipo de alojamento (NUTS 2024) (0012093)'[nuts_ii])
				    )
				)

