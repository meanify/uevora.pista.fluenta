table 'Hóspedes mensais por tipo de alojamento (NUTS 2013) (0009812)'
	lineageTag: 38b4dbac-4fbf-568f-8129-97ade2cb032e

	measure 'Hóspedes mensais (tipo)' = SUM('Hóspedes mensais por tipo de alojamento (NUTS 2013) (0009812)'[hospedes])
		formatString: #,0
		lineageTag: 3bfceae4-55c4-5020-bf4e-ee66f1023b53

	/// Hóspedes mensais por tipo de alojamento (NUTS 2013) do ano anterior.
	measure 'Hóspedes mensais (tipo, ano anterior)' = CALCULATE([Hóspedes mensais (tipo)], DATEADD('Calendário'[Date], -1, YEAR))
		formatString: #,0
		lineageTag: d5d4a792-72cb-543b-8d94-ddadf3c69bdd

	/// Variação homóloga de [Hóspedes mensais (tipo)]. Em branco sem ano anterior publicado.
	measure 'Hóspedes mensais (tipo) YoY %' =
			VAR Atual = [Hóspedes mensais (tipo)]
			VAR Anterior = [Hóspedes mensais (tipo, ano anterior)]
			RETURN DIVIDE(Atual - Anterior, Anterior)
		formatString: 0.0%
		lineageTag: b704250f-344f-5cde-9861-787a5f58db5c

	column nuts_i
		dataType: string
		lineageTag: 8b36968a-f5bc-5f24-b63c-72b5ad04a25a
