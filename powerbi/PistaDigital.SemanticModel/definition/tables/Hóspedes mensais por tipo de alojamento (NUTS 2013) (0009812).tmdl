		formatString: 0
		lineageTag: fbb6d52f-dd44-541c-a6d2-880c0811bd89
		summarizeBy: sum
		sourceColumn: ano

		annotation SummarizationSetBy = Automatic

	column mes
		dataType: string
		lineageTag: 869017a3-e4b2-5a68-8446-07707ae869c6
		summarizeBy: none
		sourceColumn: mes

	/// Primeiro dia do mês, usado para ligar ao Calendário.
	column Data
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 433dda5b-bc1f-5c9e-b40e-498e1c9a975e
		summarizeBy: none
		sourceColumn: Data

		annotation UnderlyingDateTimeDataType = Date

	column hospedes
