	column ano
		dataType: int64
		formatString: 0
		lineageTag: 4e19b486-203c-5663-abd7-75afb17b2fbd
		summarizeBy: sum
		sourceColumn: ano

		annotation SummarizationSetBy = Automatic

	column mes
		dataType: string
		lineageTag: 98af56d1-0b61-5c3b-a1c5-62f058778870
		summarizeBy: none
		sourceColumn: mes

	/// Primeiro dia do mês, usado para ligar ao Calendário.
	column Data
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 1d8f1884-04ed-5404-9d6f-e7a5d232ce65
		summarizeBy: none
		sourceColumn: Data

		annotation UnderlyingDateTimeDataType = Date

	column hospedes
		dataType: double
		formatString: #,0
		lineageTag: 1719810b-635b-5a26-915e-4c1af57eef0d
		summarizeBy: sum
		sourceColumn: hospedes

	column create_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: d320b6d8-c75d-5a75-8fa4-a986c76a2e80
		summarizeBy: none
		sourceColumn: create_date

		annotation UnderlyingDateTimeDataType = Date

	column update_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 6422a557-0131-5295-a624-f1db315560f0
		summarizeBy: none
		sourceColumn: update_date

		annotation UnderlyingDateTimeDataType = Date

	column GeoKey
		dataType: string
		isHidden
		lineageTag: 97b47ead-bea4-5b0b-b123-da44cf549d50
		summarizeBy: none
		sourceColumn: GeoKey

	column NutsIIKey
		dataType: string
		isHidden
		lineageTag: 6a4a7477-40c0-5081-938e-0da3e964af6f
		summarizeBy: none
		sourceColumn: NutsIIKey

	partition 'Hóspedes mensais por segmento (0010736)' = m
		mode: import
		source =
				let
				    Origem = Fonte{[Name = "ine_0010736_ds", Kind = "Table"]}[Data],
				    Regiao = Table.SelectRows(Origem, each [nuts_ii] = RegiaoNUTSII and [municipio] <> "Total"),
				    Folhas = Table.SelectRows(Regiao, each [segmento_alojamento] <> "Total"),
				    ComData = Table.AddColumn(Folhas, "Data", each #date([ano], Number.FromText([mes]), 1), type date),
				    GeoKey = Table.AddColumn(ComData, "GeoKey", each [nuts_i] & "|" & [nuts_ii] & "|" & [nuts_iii] & "|" & [distrito] & "|" & [municipio], type text),
				    NutsII = Table.AddColumn(GeoKey, "NutsIIKey", each [nuts_i] & "|" & [nuts_ii], type text)
				in
				    NutsII

