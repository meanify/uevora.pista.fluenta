table 'Hóspedes mensais por segmento (0010736)'
	lineageTag: c2dbe319-32ae-501c-bab6-54860950d5c5

	measure 'Hóspedes mensais (segmento)' = SUM('Hóspedes mensais por segmento (0010736)'[hospedes])
		formatString: #,0
		lineageTag: bb8c4665-bf05-5bf4-b2eb-8e37f334c32b

