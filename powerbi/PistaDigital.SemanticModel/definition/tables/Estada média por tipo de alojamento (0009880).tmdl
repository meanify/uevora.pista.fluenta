	partition 'Estada média por tipo de alojamento (0009880)' = m
		mode: import
		source =
				let
				    Origem = Fonte{[Name = "ine_0009880_ds", Kind = "Table"]}[Data],
				    GeoKey = Table.AddColumn(Origem, "GeoKey", each [nuts_i] & "|" & [nuts_ii] & "|" & [nuts_iii] & "|" & [distrito] & "|" & [municipio], type text),
				    NutsII = Table.AddColumn(GeoKey, "NutsIIKey", each [nuts_i] & "|" & [nuts_ii], type text)
				in
				    NutsII

