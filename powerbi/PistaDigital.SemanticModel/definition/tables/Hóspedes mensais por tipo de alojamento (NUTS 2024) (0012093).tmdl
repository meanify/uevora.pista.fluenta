	partition 'Hóspedes mensais por tipo de alojamento (NUTS 2024) (0012093)' = m
		mode: import
		source =
				let
				    Origem = Fonte{[Name = "ine_0012093_ds", Kind = "Table"]}[Data],
				    Regiao = Table.SelectRows(Origem, each [nuts_ii] = RegiaoNUTSII),
				    Combinacoes = Table.Buffer(Table.Distinct(Table.SelectColumns(Regiao, {"tipo_alojamento", "subtipo_alojamento"}))),
				    TiposComSubtipo = List.Buffer(List.Distinct(Table.SelectRows(Combinacoes, each [subtipo_alojamento] <> "Total")[tipo_alojamento])),
				    Folhas = Table.SelectRows(Regiao, each [tipo_alojamento] <> "Total" and ([subtipo_alojamento] <> "Total" or not List.Contains(TiposComSubtipo, [tipo_alojamento]))),
				    ComData = Table.AddColumn(Folhas, "Data", each #date([ano], Number.FromText([mes]), 1), type date),
				    GeoKey = Table.AddColumn(ComData, "NutsIIKey", each [nuts_i] & "|" & [nuts_ii], type text)
				in
				    GeoKey

