	/// Primeiro dia do mês, usado para ligar ao Calendário.
	column Data
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: d4d8d850-29f6-5a88-b79d-32171edcfd39
		summarizeBy: none
		sourceColumn: Data

		annotation UnderlyingDateTimeDataType = Date

