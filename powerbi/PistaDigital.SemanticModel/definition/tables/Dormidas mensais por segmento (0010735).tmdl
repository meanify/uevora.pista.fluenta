		sourceColumn: NutsIIKey

	partition 'Dormidas mensais por segmento (0010735)' = m
		mode: import
		source =
				let
				    Origem = Fonte{[Name = "ine_0010735_ds", Kind = "Table"]}[Data],
				    Regiao = Table.SelectRows(Origem, each [nuts_ii] = RegiaoNUTSII and [municipio] <> "Total"),
				    Folhas = Table.SelectRows(Regiao, each [segmento_alojamento] <> "Total"),
				    ComData = Table.AddColumn(Folhas, "Data", each #date([ano], Number.FromText([mes]), 1), type date),
				    GeoKey = Table.AddColumn(ComData, "GeoKey", each [nuts_i] & "|" & [nuts_ii] & "|" & [nuts_iii] & "|" & [distrito] & "|" & [municipio], type text),
				    NutsII = Table.AddColumn(GeoKey, "NutsIIKey", each [nuts_i] & "|" & [nuts_ii], type text)
				in
				    NutsII

